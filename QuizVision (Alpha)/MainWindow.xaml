<Window x:Class="QuizVision__Alpha_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuizVision (Alpha)"
        Height="750"
        Width="1000"
        MinHeight="650"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#090B12">

    <Window.Resources>

        <!-- ================= COLORS ================= -->

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#10131D"/>

        <SolidColorBrush x:Key="BorderBrushDark"
                         Color="#252A3A"/>

        <SolidColorBrush x:Key="PrimaryText"
                         Color="#F5F7FF"/>

        <SolidColorBrush x:Key="SecondaryText"
                         Color="#8B93A7"/>

        <SolidColorBrush x:Key="MutedText"
                         Color="#5F6678"/>

        <SolidColorBrush x:Key="Accent"
                         Color="#7C5CFF"/>

        <SolidColorBrush x:Key="AccentLight"
                         Color="#A78BFA"/>


        <!-- ================= COMBOBOX ITEM ================= -->

        <Style x:Key="DarkComboBoxItem"
               TargetType="{x:Type ComboBoxItem}">

            <Setter Property="Background"
                    Value="#10131D"/>

            <Setter Property="Foreground"
                    Value="#E8EBF5"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                        <Border x:Name="ItemBackground"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted"
                                     Value="True">

                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="#211A3D"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="#2A2150"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================= DARK COMBOBOX ================= -->

        <Style x:Key="DarkComboBox"
               TargetType="{x:Type ComboBox}">

            <Setter Property="Foreground"
                    Value="#E8EBF5"/>

            <Setter Property="Background"
                    Value="#0B0E16"/>

            <Setter Property="BorderBrush"
                    Value="#2A3042"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DarkComboBoxItem}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBox}">

                        <Grid>

                            <!-- CLOSED COMBOBOX -->

                            <ToggleButton x:Name="DropDownButton"
                                          Background="#0B0E16"
                                          BorderBrush="#2A3042"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}">

                                <Grid>

                                    <!-- SELECTED WINDOW -->

                                    <ContentPresenter
                                        Margin="11,0,40,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        TextElement.Foreground="#E8EBF5"
                                        TextElement.FontSize="13"/>


                                    <!-- ARROW -->

                                    <Border Width="34"
                                            HorizontalAlignment="Right"
                                            Background="#151927"
                                            BorderBrush="#2A3042"
                                            BorderThickness="1,0,0,0">

                                        <TextBlock Text="▼"
                                                   FontSize="9"
                                                   Foreground="#A78BFA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                </Grid>

                            </ToggleButton>


                            <!-- DROPDOWN -->

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">

                                <Border Background="#10131D"
                                        BorderBrush="#3A4052"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0">

                                    <ScrollViewer MaxHeight="300"
                                                  CanContentScroll="True">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <!-- HOVER -->

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="DropDownButton"
                                        Property="BorderBrush"
                                        Value="#7C5CFF"/>

                            </Trigger>


                            <!-- OPEN -->

                            <Trigger Property="IsDropDownOpen"
                                     Value="True">

                                <Setter TargetName="DropDownButton"
                                        Property="BorderBrush"
                                        Value="#7C5CFF"/>

                            </Trigger>


                            <!-- DISABLED -->

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="DropDownButton"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================= NORMAL BUTTON ================= -->

        <Style x:Key="CleanButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#151927"/>

            <Setter Property="Foreground"
                    Value="#DDE2F0"/>

            <Setter Property="BorderBrush"
                    Value="#2A3042"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="14,7"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ================= SCAN BUTTON ================= -->

        <Style x:Key="ScanButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#7C5CFF"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#9A83FF"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Padding"
                    Value="20,9"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <!-- ================= MAIN LAYOUT ================= -->

    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ================= HEADER ================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <StackPanel>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="QUIZ"
                               FontSize="29"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="VISION"
                               FontSize="29"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentLight}"/>

                    <Border Background="#19152D"
                            BorderBrush="#3B2E70"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,3"
                            Margin="10,4,0,0">

                        <TextBlock Text="ALPHA"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentLight}"/>

                    </Border>

                </StackPanel>


                <TextBlock Text="AI-powered visual teaching assistant"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryText}"
                           Margin="1,4,0,0"/>

            </StackPanel>


            <!-- GEMINI STATUS -->

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#0E2119"
                    BorderBrush="#1D5739"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="12,7">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="8"
                             Height="8"
                             Fill="#35E58A"
                             VerticalAlignment="Center"/>

                    <TextBlock Text="Gemini Connected"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#63E6A5"
                               Margin="7,0,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ================= TARGET WINDOW ================= -->

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,16">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{StaticResource Accent}"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text=" TARGET WINDOW"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="5,0,0,6"/>

                    </StackPanel>


                    <!-- FIXED DARK WINDOW DROPDOWN -->

                    <ComboBox x:Name="WindowList"
                              Style="{StaticResource DarkComboBox}"
                              Height="36"/>

                </StackPanel>


                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Content="⟳  Refresh"
                        Width="105"
                        Height="36"
                        Margin="10,16,0,0"
                        Style="{StaticResource CleanButton}"
                        Click="RefreshButton_Click"/>

            </Grid>

        </Border>


        <!-- ================= PREVIEW ================= -->

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- PREVIEW HEADER -->

                <Grid Grid.Row="0">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="LIVE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentLight}"/>

                            <TextBlock Text="  SCREEN PREVIEW"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryText}"/>

                        </StackPanel>


                        <TextBlock Text="Selected window capture"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"
                                   Margin="0,3,0,0"/>

                    </StackPanel>


                    <!-- STATUS -->

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#151927"
                            BorderBrush="#292F41"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,5">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="6"
                                     Height="6"
                                     Fill="{StaticResource AccentLight}"
                                     VerticalAlignment="Center"/>

                            <TextBlock x:Name="ScanStatusText"
                                       Text="Ready"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#AAB2C5"
                                       Margin="6,0,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- SCREEN -->

                <Border Grid.Row="1"
                        Margin="0,14,0,14"
                        Background="#070910"
                        BorderBrush="#292F41"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">

                    <Grid>

                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>


                        <!-- PLACEHOLDER -->

                        <StackPanel x:Name="PreviewPlaceholder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Border Width="70"
                                    Height="70"
                                    CornerRadius="35"
                                    Background="#17132B"
                                    BorderBrush="#3A2E70"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">

                                <TextBlock Text="◈"
                                           FontSize="32"
                                           Foreground="{StaticResource AccentLight}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <TextBlock Text="WAITING FOR SCAN"
                                       Foreground="#858DA0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>


                            <TextBlock x:Name="PreviewWindowText"
                                       Text="No window selected"
                                       Foreground="White"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="20,6,20,0"/>


                            <TextBlock x:Name="PreviewHandleText"
                                       Text="Handle: —"
                                       Foreground="{StaticResource MutedText}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- SCAN -->

                <Button Grid.Row="2"
                        x:Name="ScanButton"
                        Content="◉  SCAN SELECTED WINDOW"
                        Height="40"
                        Width="245"
                        HorizontalAlignment="Center"
                        Style="{StaticResource ScanButtonStyle}"
                        Click="ScanButton_Click"/>

            </Grid>

        </Border>


        <!-- ================= AI RESULT ================= -->

        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,16,0,0"
                Padding="16">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="0.9*"/>

                    <ColumnDefinition Width="1.5*"/>

                </Grid.ColumnDefinitions>


                <!-- ANSWER -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{StaticResource Accent}"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text=" SUGGESTED ANSWER"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="5,0,0,0"/>

                    </StackPanel>


                    <Border Background="#15132A"
                            BorderBrush="#352B61"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,8"
                            Margin="0,6,0,0">

                        <TextBlock x:Name="AnswerText"
                                   Text="No answer yet"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentLight}"
                                   TextWrapping="Wrap"/>

                    </Border>

                </StackPanel>


                <!-- EXPLANATION -->

                <StackPanel Grid.Column="1">

                    <TextBlock Text="AI EXPLANATION"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource SecondaryText}"/>

                    <TextBlock x:Name="ExplanationText"
                               Text="Scan a window to begin."
                               FontSize="13"
                               Foreground="{StaticResource PrimaryText}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>